# Mini Zoopla API — environment configuration (copy to .env and edit)
# Real shell environment variables override anything set here.

# Network
# bind address. Use 0.0.0.0 to expose on all interfaces (not recommended; use Cloudflare Tunnel instead)
MINI_ZOOPLA_HOST=127.0.0.1
# listen port
MINI_ZOOPLA_PORT=8000

# Security / key management
# REQUIRED to enable /admin/* key-management endpoints. Generate one with:
#   openssl rand -hex 24
MINI_ZOOPLA_ADMIN_KEY=

# Tuning
# default requests/minute per key owner
MINI_ZOOPLA_RATE_LIMIT=60
# response cache TTL in seconds (avoids re-scraping)
MINI_ZOOPLA_CACHE_TTL=300
# path to the API-key store (SQLite)
MINI_ZOOPLA_KEYS_DB=keys.db
