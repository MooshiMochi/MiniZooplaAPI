# Mini Zoopla API — environment configuration (copy to .env and edit)
# Real shell environment variables override anything set here.

# Network
MINI_ZOOLA_HOST=127.0.0.1      # bind address. Use 0.0.0.0 to expose on all interfaces (not recommended; use Cloudflare Tunnel instead)
MINI_ZOOLA_PORT=8000           # listen port

# Security / key management
# REQUIRED to enable /admin/* key-management endpoints. Generate one with:
#   openssl rand -hex 24
MINI_ZOOLA_ADMIN_KEY=

# Tuning
MINI_ZOOLA_RATE_LIMIT=60       # default requests/minute per key owner
MINI_ZOOLA_CACHE_TTL=300       # response cache TTL in seconds (avoids re-scraping)
MINI_ZOOLA_KEYS_DB=keys.db     # path to the API-key store (SQLite)
